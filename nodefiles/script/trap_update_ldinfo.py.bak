def callback(key,value):
        if key == 'Virtual Drive':
                value = value.split(' ',1)[0]
        if key == 'PD':
                value = value.split(' ',1)[0]
        return value
def main():





    result_dict = dict()
    list_element = list()
    vid=sys.argv[1]

    content=subprocess.Popen("/opt/MegaRAID/storcli/storcli64 /c0 /vall show all J",shell=True,stdout=subprocess.PIPE,stderr=subprocess.PIPE)        
    stdout, stderr = content.communicate()
    json_str = json.loads(stdout)
    controller=json_str["Controllers"][0]["Response Data"]
        
    Properties="VD"+vid+" Properties"
    disk_path=controller[Properties]["OS Drive Name"].split('/')        
    
    LD="/c0/v"+vid
    raidlevel=controller[LD][0]["TYPE"]
    raidsize=controller[LD][0]["Size"]
    raidstate=controller[LD][0]["State"]
        
    list_element_dict = dict()
    list_element_dict["raidlevel"] = raidlevel
    list_element_dict["raidsize"] = raidsize
    list_element_dict["raidstate"] = raidstate
    list_element_dict["raidpath"] = disk_path[2]
    list_element.append(list_element_dict)    
    result = json.dumps(list_element_dict)
    print result        
        









